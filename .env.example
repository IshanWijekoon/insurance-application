APP_ENV=development
APP_NAME=AI Motor Insurance Claim Assessment
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://insurance:insurance@localhost:5432/insurance

# At least 32 characters. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=local-dev-secret-change-me-please-32chars

CORS_ORIGINS=http://localhost:3000

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=claim-images

# mock | gemini | openrouter | deepseek
AI_PROVIDER=mock
VISION_PROVIDER=mock
AI_FALLBACK_CHAIN=

GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

MARKET_RESEARCH_ENABLED=true
MARKET_COUNTRY=LK
MARKET_CURRENCY=LKR
# none | serper | tavily | brave
SEARCH_PROVIDER=none
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

LABOUR_RATE_PER_HOUR=2500
PAINT_RATE_PER_PANEL=12000

MAP_API_KEY=
GEOCODING_API_KEY=
